  "source_commit": "c49627737bf23bbc15c7e5bfa689853d7337aa08",
  "source_fingerprint": "8e350912b667ec80937f5c30e7ee71b8d54b7634f95e714c3e64c7db21b45300",
  "nodes": [
    {
      "id": "mop:D-001",
      "type": "decision",
      "namespace": "mop",
      "text": "Estruturar cada indicador nas etapas fato detalhado, KPI fato, catálogo e KPI final. Atende R-007 e R-009.",
      "source": {
        "path": "_applications/mop/DECISIONS.md",
        "locator": "D-001"
      }
    },
    {
      "id": "mop:D-002",
      "type": "decision",
      "namespace": "mop",
      "text": "Identificar a série por uma chave CCIO composta pelo indicador base, visão, grão temporal e versão. Atende R-001.",
      "source": {
        "path": "_applications/mop/DECISIONS.md",
        "locator": "D-002"
      }
    },
    {
      "id": "mop:D-003",
      "type": "decision",
      "namespace": "mop",
      "text": "Usar o grão mensal como padrão de publicação, permitindo que cada indicador defina outros grãos temporais, preservando as datas de referência, apuração e congelamento. Atende R-002.",
      "source": {
        "path": "_applications/mop/DECISIONS.md",
        "locator": "D-003"
      }
    },
    {
      "id": "mop:D-004",
      "type": "decision",
      "namespace": "mop",
      "text": "Preservar as ocorrências no menor grão do indicador, agregá-las inicialmente no nível contrato e consolidar as medidas nos níveis regional e distribuidora. Atende R-003 e R-007.",
      "source": {
        "path": "_applications/mop/DECISIONS.md",
        "locator": "D-004"
      }
    },
    {
      "id": "mop:D-005",
      "type": "decision",
      "namespace": "mop",
      "text": "Manter fatos e resultados nas apurações `VIVA` e `CONGELADA` e reuni-los no catálogo do indicador. Atende R-004 e R-009.",
      "source": {
        "path": "_applications/mop/DECISIONS.md",
        "locator": "D-005"
      }
    },
    {
      "id": "mop:D-006",
      "type": "decision",
      "namespace": "mop",
      "text": "Apurar versões em paralelo e incorporar versão, status da versão e origem à identidade de cada resultado. Atende R-005.",
      "source": {
        "path": "_applications/mop/DECISIONS.md",
        "locator": "D-006"
      }
    },
    {
      "id": "mop:D-007",
      "type": "decision",
      "namespace": "mop",
      "text": "Incorporar a visão à identidade da série como recorte da população apurada. Atende R-008.",
      "source": {
        "path": "_applications/mop/DECISIONS.md",
        "locator": "D-007"
      }
    },
    {
      "id": "mop:D-008",
      "type": "decision",
      "namespace": "mop",
      "text": "Dar precedência ao controle manual de expurgo e zerar a contribuição da linha sem removê-la do detalhe. Atende R-006.",
      "source": {
        "path": "_applications/mop/DECISIONS.md",
        "locator": "D-008"
      }
    },
    {
      "id": "mop:D-009",
      "type": "decision",
      "namespace": "mop",
      "text": "Compor medidas auditáveis no KPI fato a partir de valores base e, quando aplicável, suplementos, preservando separadamente sua origem e seu grão antes de calcular a fórmula específica no KPI final. Atende R-007.",
      "source": {
        "path": "_applications/mop/DECISIONS.md",
        "locator": "D-009"
      }
    },
    {
      "id": "mop:O-001",
      "type": "operation",
      "namespace": "mop",
      "text": "Cada indicador define sua unidade elementar no menor grão disponível, preservando o dia e a equipe quando fizerem parte da ocorrência.",
      "source": {
        "path": "_applications/mop/OPERATIONS.md",
        "locator": "O-001"
      }
    },
    {
      "id": "mop:O-002",
      "type": "operation",
      "namespace": "mop",
      "text": "Cada unidade recebe uma data de referência, da qual são derivadas as competências temporais necessárias à apuração.",
      "source": {
        "path": "_applications/mop/OPERATIONS.md",
        "locator": "O-002"
      }
    },
    {
      "id": "mop:O-003",
      "type": "operation",
      "namespace": "mop",
      "text": "Cada unidade é situada na hierarquia organizacional formada por equipe, contrato, regional e distribuidora.",
      "source": {
        "path": "_applications/mop/OPERATIONS.md",
        "locator": "O-003"
      }
    },
    {
      "id": "mop:O-004",
      "type": "operation",
      "namespace": "mop",
      "text": "A unidade é relacionada às demais entidades necessárias para receber suas classificações de negócio.",
      "source": {
        "path": "_applications/mop/OPERATIONS.md",
        "locator": "O-004"
      }
    },
    {
      "id": "mop:O-005",
      "type": "operation",
      "namespace": "mop",
      "text": "As classificações determinam a população apurada e a contribuição individual para cada medida do indicador.",
      "source": {
        "path": "_applications/mop/OPERATIONS.md",
        "locator": "O-005"
      }
    },
    {
      "id": "mop:O-006",
      "type": "operation",
      "namespace": "mop",
      "text": "Ocorrências expurgadas permanecem no detalhe e na auditoria, mas deixam de contribuir para as medidas agregadas.",
      "source": {
        "path": "_applications/mop/OPERATIONS.md",
        "locator": "O-006"
      }
    },
    {
      "id": "mop:O-007",
      "type": "operation",
      "namespace": "mop",
      "text": "As contribuições são inicialmente preservadas no menor grão temporal e organizacional necessário ao indicador.",
      "source": {
        "path": "_applications/mop/OPERATIONS.md",
        "locator": "O-007"
      }
    },
    {
      "id": "mop:O-008",
      "type": "operation",
      "namespace": "mop",
      "text": "As contribuições no menor grão do indicador são consolidadas no período e no nível organizacional definidos para publicação.",
      "source": {
        "path": "_applications/mop/OPERATIONS.md",
        "locator": "O-008"
      }
    },
    {
      "id": "mop:O-009",
      "type": "operation",
      "namespace": "mop",
      "text": "No nível contrato, as unidades são agrupadas por competência, visão, versão e demais dimensões próprias do indicador.",
      "source": {
        "path": "_applications/mop/OPERATIONS.md",
        "locator": "O-009"
      }
    },
    {
      "id": "mop:O-010",
      "type": "operation",
      "namespace": "mop",
      "text": "Quando uma medida prevê suplementos, eles são associados aos valores base no mesmo grão antes da agregação do período, preservando separadamente sua origem.",
      "source": {
        "path": "_applications/mop/OPERATIONS.md",
        "locator": "O-010"
      }
    },
    {
      "id": "mop:O-011",
      "type": "operation",
      "namespace": "mop",
      "text": "As medidas do nível contrato são posteriormente consolidadas nos níveis regional e distribuidora.",
      "source": {
        "path": "_applications/mop/OPERATIONS.md",
        "locator": "O-011"
      }
    },
    {
      "id": "mop:O-012",
      "type": "operation",
      "namespace": "mop",
      "text": "Os valores acumulados são obtidos pela soma temporal das medidas dentro de cada série e nível organizacional.",
      "source": {
        "path": "_applications/mop/OPERATIONS.md",
        "locator": "O-012"
      }
    },
    {
      "id": "mop:O-013",
      "type": "operation",
      "namespace": "mop",
      "text": "A fórmula específica do indicador é aplicada às medidas já agregadas para produzir os resultados do período e acumulado.",
      "source": {
        "path": "_applications/mop/OPERATIONS.md",
        "locator": "O-013"
      }
    },
    {
      "id": "mop:R-001",
      "type": "requirement",
      "namespace": "mop",
      "text": "Identificar inequivocamente cada série por indicador, visão, grão temporal e versão da regra de negócio.",
      "source": {
        "path": "_applications/mop/REQUIREMENTS.md",
        "locator": "R-001"
      }
    },
    {
      "id": "mop:R-002",
      "type": "requirement",
      "namespace": "mop",
      "text": "Organizar o detalhe e os resultados por competência, preservando a data de referência, a data de apuração e, quando aplicável, a data de congelamento.",
      "source": {
        "path": "_applications/mop/REQUIREMENTS.md",
        "locator": "R-002"
      }
    },
    {
      "id": "mop:R-003",
      "type": "requirement",
      "namespace": "mop",
      "text": "Disponibilizar resultados consistentes nos níveis organizacionais aplicáveis, incluindo contrato, regional e distribuidora.",
      "source": {
        "path": "_applications/mop/REQUIREMENTS.md",
        "locator": "R-003"
      }
    },
    {
      "id": "mop:R-004",
      "type": "requirement",
      "namespace": "mop",
      "text": "Distinguir a apuração recalculável da fotografia histórica preservada.",
      "source": {
        "path": "_applications/mop/REQUIREMENTS.md",
        "locator": "R-004"
      }
    },
    {
      "id": "mop:R-005",
      "type": "requirement",
      "namespace": "mop",
      "text": "Permitir a apuração paralela de diferentes versões, preservando a identidade, o estado e a origem de cada resultado.",
      "source": {
        "path": "_applications/mop/REQUIREMENTS.md",
        "locator": "R-005"
      }
    },
    {
      "id": "mop:R-006",
      "type": "requirement",
      "namespace": "mop",
      "text": "Permitir expurgos de negócio sem remover a ocorrência original nem perder a justificativa da exceção.",
      "source": {
        "path": "_applications/mop/REQUIREMENTS.md",
        "locator": "R-006"
      }
    },
    {
      "id": "mop:R-007",
      "type": "requirement",
      "namespace": "mop",
      "text": "Permitir reconciliar o resultado do indicador com suas medidas componentes, incluindo eventuais suplementos, e com as ocorrências consideradas ou desconsideradas na apuração.",
      "source": {
        "path": "_applications/mop/REQUIREMENTS.md",
        "locator": "R-007"
      }
    },
    {
      "id": "mop:R-008",
      "type": "requirement",
      "namespace": "mop",
      "text": "Tratar cada visão como um recorte explícito das ocorrências que podem participar da apuração.",
      "source": {
        "path": "_applications/mop/REQUIREMENTS.md",
        "locator": "R-008"
      }
    },
    {
      "id": "mop:R-009",
      "type": "requirement",
      "namespace": "mop",
      "text": "Proteger os resultados históricos contra recálculo ou substituição silenciosa.",
      "source": {
        "path": "_applications/mop/REQUIREMENTS.md",
        "locator": "R-009"
      }
    },
    {
      "id": "namespace:mop",
      "type": "namespace",
      "namespace": "mop",
      "source": {
        "path": "_applications/mop",
        "locator": "mop"
      }
